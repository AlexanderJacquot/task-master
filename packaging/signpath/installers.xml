<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installers" (ADR 036): the NSIS setup and the MSI,
  bundled from the executables signed with "binaries". Tauri writes the setup's product
  name and version (NSIS VIAddVersionKey) and the MSI's subject (product name) and author
  (the manufacturer, from the identifier space.solarnexus.taskmaster). Paste this into
  SignPath (project task-master, Artifact configurations, slug "installers").
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="task-master_${version}_x64-setup.exe" product-name="task-master" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <msi-file path="task-master_${version}_x64_en-US.msi" subject="task-master" author="solarnexus">
      <authenticode-sign />
    </msi-file>
  </zip-file>
</artifact-configuration>
