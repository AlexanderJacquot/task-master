{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "task-master",
  "version": "0.12.0",
  "identifier": "space.solarnexus.taskmaster",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "task-master",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      },
      {
        "label": "capture",
        "title": "Quick capture",
        "width": 660,
        "height": 230,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: tm: http://tm.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAwNTQzOUJEOTEwQzNEQjMKUldTelBReVJ2VGxVQUI5ZWg3bUY4QXY2THpreHdyVkFWbHdoSEJ0eThjeE1zRmlZRk4xUEF6RmcK",
      "endpoints": [
        "https://github.com/AlexanderJacquot/task-master/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
