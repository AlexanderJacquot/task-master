{
  "name": "task-master",
  "private": true,
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter desktop tauri dev",
    "assets:generate": "node scripts/generate-ui-icons.mjs && node scripts/generate-app-icons.mjs",
    "build": "pnpm --filter desktop tauri build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4"
  }
}
